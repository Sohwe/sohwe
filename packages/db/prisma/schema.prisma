generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                     String                  @id @default(uuid())
  name                   String
  slug                   String                  @unique
  createdAt              DateTime                @default(now()) @map("created_at")
  users                  User[]
  applications           Application[]
  projects               Project[]
  backupDestinations     BackupDestination[]
  bundles                Bundle[]
  backupSchedules        BackupSchedule[]
  githubApp              GitHubApp?
  webhookDeliveries      WebhookDelivery[]
  invitations            Invitation[]
  auditLogs              AuditLog[]
  datastores             Datastore[]
  dnsProviderCredentials DnsProviderCredential[]

  @@map("organizations")
}

// --- Phase 9: projects and coordinated multi-service releases -------------

// Applications remain the backwards-compatible single-container deployment
// model. A Project is the multi-service deployment group: one repository and
// branch are resolved once, then every Service is built from that exact commit.
model Project {
  id                String                    @id @default(uuid())
  organizationId    String                    @map("organization_id")
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  slug              String
  gitRepo           String                    @map("git_repository")
  gitBranch         String                    @default("main") @map("git_branch")
  repoFullName      String?                   @map("repo_full_name")
  autoDeploy        Boolean                   @default(false) @map("auto_deploy")
  status            String                    @default("idle") // idle | deploying | running | crashed | stopped
  envVarsEncrypted  Bytes?                    @map("env_vars_encrypted")
  currentReleaseId  String?                   @unique @map("current_release_id")
  currentRelease    ProjectRelease?           @relation("CurrentProjectRelease", fields: [currentReleaseId], references: [id], onDelete: SetNull)
  services          Service[]
  releases          ProjectRelease[]          @relation("ProjectReleases")
  logs              ServiceLog[]
  datastoreBindings ProjectDatastoreBinding[]
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  @@unique([organizationId, slug])
  @@index([repoFullName])
  @@map("projects")
}

// A service is configuration, not a mutable Docker container identity.
// `http` is routed; `worker` is long-running but private; `release` runs once
// before a release is promoted. A project may have at most one release service
// (enforced by the API; PostgreSQL migration adds the partial unique index).
model Service {
  id                            String              @id @default(uuid())
  projectId                     String              @map("project_id")
  project                       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                          String
  slug                          String
  kind                          String // http | worker | release
  buildMode                     String              @default("dockerfile") @map("build_mode")
  buildCmd                      String?             @map("build_command")
  startCmd                      String?             @map("start_command")
  runtimeCmd                    String?             @map("runtime_command")
  serviceDirectory              String              @default(".") @map("service_directory")
  workspaceSelector             String?             @map("workspace_selector")
  dockerfilePath                String              @default("Dockerfile") @map("dockerfile_path")
  dockerTarget                  String?             @map("docker_target")
  imageGroup                    String?             @map("image_group")
  port                          Int?
  envVarsEncrypted              Bytes?              @map("env_vars_encrypted")
  buildArgsEncrypted            Bytes?              @map("build_args_encrypted")
  memoryLimitMb                 Int?                @map("memory_limit_mb")
  cpuLimit                      Float?              @map("cpu_limit")
  restartPolicy                 String              @default("unless-stopped") @map("restart_policy")
  healthCheckCmd                String?             @map("health_check_command") @db.Text
  healthCheckIntervalSeconds    Int                 @default(10) @map("health_check_interval_seconds")
  healthCheckTimeoutSeconds     Int                 @default(5) @map("health_check_timeout_seconds")
  healthCheckRetries            Int                 @default(3) @map("health_check_retries")
  healthCheckStartPeriodSeconds Int                 @default(2) @map("health_check_start_period_seconds")
  domains                       ServiceDomain[]
  dependencies                  ServiceDependency[] @relation("DependentService")
  dependents                    ServiceDependency[] @relation("DependencyService")
  deployments                   ServiceDeployment[]
  logs                          ServiceLog[]
  createdAt                     DateTime            @default(now()) @map("created_at")
  updatedAt                     DateTime            @updatedAt @map("updated_at")

  @@unique([projectId, slug])
  @@index([projectId, kind])
  @@map("services")
}

model ServiceDependency {
  serviceId           String   @map("service_id")
  service             Service  @relation("DependentService", fields: [serviceId], references: [id], onDelete: Cascade)
  dependencyServiceId String   @map("dependency_service_id")
  dependencyService   Service  @relation("DependencyService", fields: [dependencyServiceId], references: [id], onDelete: Restrict)
  condition           String   @default("healthy") // started | healthy
  createdAt           DateTime @default(now()) @map("created_at")

  @@id([serviceId, dependencyServiceId])
  @@index([dependencyServiceId])
  @@map("service_dependencies")
}

model ServiceDomain {
  id        String   @id @default(uuid())
  serviceId String   @map("service_id")
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  hostname  String   @unique
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([serviceId])
  @@map("service_domains")
}

model ProjectRelease {
  id                 String              @id @default(uuid())
  projectId          String              @map("project_id")
  project            Project             @relation("ProjectReleases", fields: [projectId], references: [id], onDelete: Cascade)
  currentForProject  Project?            @relation("CurrentProjectRelease")
  commitSha          String?             @map("commit_sha")
  commitMessage      String?             @map("commit_message") @db.Text
  trigger            String              @default("manual") // manual | push | rollback
  sourceReleaseId    String?             @map("source_release_id")
  sourceRelease      ProjectRelease?     @relation("ProjectReleaseRollback", fields: [sourceReleaseId], references: [id], onDelete: SetNull)
  rollbackReleases   ProjectRelease[]    @relation("ProjectReleaseRollback")
  status             String              @default("pending") // pending | building | releasing | deploying | success | failed
  errorMessage       String?             @map("error_message") @db.Text
  startedAt          DateTime?           @map("started_at")
  finishedAt         DateTime?           @map("finished_at")
  serviceDeployments ServiceDeployment[]
  logs               ServiceLog[]
  createdAt          DateTime            @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@map("project_releases")
}

model ServiceDeployment {
  id           String         @id @default(uuid())
  releaseId    String         @map("release_id")
  release      ProjectRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  serviceId    String         @map("service_id")
  service      Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  imageTag     String?        @map("image_tag")
  status       String         @default("pending") // pending | building | built | running | success | failed
  buildLogs    String?        @map("build_logs") @db.Text
  errorMessage String?        @map("error_message") @db.Text
  exitCode     Int?           @map("exit_code")
  containerId  String?        @map("container_id")
  startedAt    DateTime?      @map("started_at")
  finishedAt   DateTime?      @map("finished_at")
  logs         ServiceLog[]
  createdAt    DateTime       @default(now()) @map("created_at")

  @@unique([releaseId, serviceId])
  @@index([serviceId, createdAt])
  @@map("service_deployments")
}

// Runtime and one-shot job output is persisted before it is broadcast. This
// keeps per-service history available across SSE, worker, and container restarts.
model ServiceLog {
  id                    BigInt            @id @default(autoincrement())
  projectId             String            @map("project_id")
  project               Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId             String            @map("service_id")
  service               Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  releaseId             String            @map("release_id")
  release               ProjectRelease    @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  serviceDeploymentId   String            @map("service_deployment_id")
  serviceDeployment     ServiceDeployment @relation(fields: [serviceDeploymentId], references: [id], onDelete: Cascade)
  stream                String // stdout | stderr | system
  level                 String            @default("info") // debug | info | warn | error
  message               String            @db.Text
  eventKey              String?           @unique @map("event_key")
  containerId           String?           @map("container_id")
  containerTimestamp    DateTime?         @map("container_timestamp")
  containerTimestampRaw String?           @map("container_timestamp_raw")
  restartNumber         Int               @default(0) @map("restart_number")
  createdAt             DateTime          @default(now()) @map("created_at")

  @@index([projectId, id])
  @@index([serviceId, id])
  @@index([releaseId, id])
  @@map("service_logs")
}

model User {
  id                  String       @id @default(uuid())
  email               String       @unique
  passwordHash        String       @map("password_hash")
  name                String?
  role                String       @default("owner") // owner | admin | member
  organizationId      String       @map("organization_id")
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt           DateTime     @default(now()) @map("created_at")
  sessions            Session[]
  invitationsSent     Invitation[] @relation("InvitationInviter")
  invitationsAccepted Invitation[] @relation("InvitationAcceptor")
  auditLogs           AuditLog[]

  @@index([organizationId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model Application {
  id                 String             @id @default(uuid())
  organizationId     String             @map("organization_id")
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  slug               String
  gitRepo            String             @map("git_repository")
  gitBranch          String             @default("main") @map("git_branch")
  // `owner/repo` when gitRepo points at GitHub. Denormalized from gitRepo so
  // the push webhook can resolve a delivery to apps with one indexed lookup
  // instead of parsing every repo URL in the org.
  repoFullName       String?            @map("repo_full_name")
  // Deploy automatically when the tracked branch (gitBranch) receives a push.
  autoDeploy         Boolean            @default(false) @map("auto_deploy")
  buildMode          String             @default("auto") @map("build_mode") // auto | dockerfile | nixpacks
  buildCmd           String?            @map("build_command")
  startCmd           String?            @map("start_command")
  runtimeCmd         String?            @map("runtime_command")
  dockerfilePath     String             @default("Dockerfile") @map("dockerfile_path")
  dockerTarget       String?            @map("docker_target")
  port               Int                @default(3000)
  envVarsEncrypted   Bytes?             @map("env_vars_encrypted")
  // Variables exposed to the *build* (nixpacks `--env`, docker `--build-arg`),
  // e.g. NIXPACKS_NODE_VERSION or NEXT_PUBLIC_* values Next.js inlines at build
  // time. Separate from envVarsEncrypted because these end up baked into image
  // layers and are visible in `docker history`; runtime env vars are not.
  buildArgsEncrypted Bytes?             @map("build_args_encrypted")
  memoryLimitMb      Int?               @map("memory_limit_mb")
  cpuLimit           Float?             @map("cpu_limit")
  status             String             @default("idle") // idle | deploying | running | crashed | stopped
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deployments        Deployment[]
  volumes            Volume[]
  domains            Domain[]
  alertDestinations  AlertDestination[]
  datastoreBindings  DatastoreBinding[]

  @@unique([organizationId, slug])
  @@index([repoFullName])
  @@map("applications")
}

model Deployment {
  id            String      @id @default(uuid())
  applicationId String      @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  commitSha     String?     @map("commit_sha")
  commitMessage String?     @map("commit_message") @db.Text
  imageTag      String?     @map("image_tag")
  // What caused this deployment: manual | push | rollback. Drives the
  // deployments table badge and whether a commit status is reported back.
  trigger       String      @default("manual")
  status        String      @default("pending") // pending | building | running | success | failed | cancelled
  buildLogs     String?     @map("build_logs") @db.Text
  errorMessage  String?     @map("error_message") @db.Text
  startedAt     DateTime?   @map("started_at")
  finishedAt    DateTime?   @map("finished_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([applicationId, createdAt])
  @@map("deployments")
}

model Volume {
  id            String      @id @default(uuid())
  applicationId String      @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  mountPath     String      @map("mount_path")
  sizeBytes     BigInt?     @map("size_bytes")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([applicationId, mountPath])
  @@map("volumes")
}

// A hostname an application answers on, beyond its generated
// `<slug>.<base-domain>` subdomain. Replaces the old single
// `applications.domain` column: an app can carry several (apex + www, a
// vanity domain, a migration cutover) and every one of them becomes a
// `Host()` rule on the container's Traefik router.
model Domain {
  id            String      @id @default(uuid())
  applicationId String      @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // Globally unique, not per-app: Traefik routes by host across the whole
  // instance, so two apps claiming one hostname would cross-route traffic.
  hostname      String      @unique
  // The domain shown as *the* URL for the app in the dashboard, and the one
  // links point at. At most one per app; enforced in the API, not in SQL —
  // a partial unique index would read as drift to `prisma migrate diff`.
  isPrimary     Boolean     @default(false) @map("is_primary")
  // Hostname of another domain on the same app that this one permanently
  // redirects to (the Vercel-style `www.example.com` → `example.com` pairing).
  // Null means the hostname serves the app directly. Mutually exclusive with
  // `isPrimary`; both invariants are enforced in the API, not in SQL.
  redirectTo    String?     @map("redirect_to")
  // Cached result of the last DNS check (`verified` | `mismatch` |
  // `unresolved` | `unknown`), so the domain list renders without a lookup
  // per row. Null until the domain has been checked once.
  lastStatus    String?     @map("last_status")
  lastCheckedAt DateTime?   @map("last_checked_at")
  // First time the domain was observed pointing here. Kept separate from
  // `lastCheckedAt` so a transient DNS failure does not erase the fact that
  // it verified at some point.
  verifiedAt    DateTime?   @map("verified_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([applicationId])
  @@map("domains")
}

model AlertDestination {
  id            String      @id @default(uuid())
  applicationId String      @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String // discord | slack | generic
  name          String
  url           String
  enabled       Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([applicationId])
  @@map("alert_destinations")
}

// --- Phase 5: Git-push deploys ---------------------------------------------

// The GitHub App this Sohwe instance owns, created through GitHub's app
// manifest flow. There is one App registration per Sohwe organization, with
// one installation row for every GitHub personal account or organization that
// has granted it repository access.
//
// credentialsEncrypted holds { pem, webhookSecret, clientSecret } encrypted with
// the instance key (SOHWE_ENCRYPTION_KEY). Those values are never returned by
// the API; the private key signs app JWTs and the webhook secret verifies
// deliveries, both server-side only.
model GitHubApp {
  id                   String               @id @default(uuid())
  organizationId       String               @unique @map("organization_id")
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appId                Int                  @map("app_id")
  slug                 String
  name                 String
  clientId             String               @map("client_id")
  htmlUrl              String               @map("html_url")
  /// GitHub account/org that owns the app, for display only.
  ownerLogin           String?              @map("owner_login")
  credentialsEncrypted Bytes                @map("credentials_encrypted")
  /// New Apps are installable on multiple accounts. False identifies a legacy
  /// private App that must be reconnected before another account can install it.
  multiAccount         Boolean              @default(false) @map("multi_account")
  installations        GitHubInstallation[]
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@index([appId])
  @@map("github_apps")
}

model GitHubInstallation {
  id                  String    @id @default(uuid())
  githubAppId         String    @map("github_app_id")
  githubApp           GitHubApp @relation(fields: [githubAppId], references: [id], onDelete: Cascade)
  /// GitHub-assigned installation id, globally unique on github.com.
  installationId      Int       @unique @map("installation_id")
  /// Null only for an installation migrated from a pre-multi-account release;
  /// the next GitHub setup callback fills in its account metadata.
  accountLogin        String?   @map("account_login")
  accountType         String?   @map("account_type") // Organization | User
  repositorySelection String?   @map("repository_selection") // all | selected
  htmlUrl             String?   @map("html_url")
  installedAt         DateTime  @default(now()) @map("installed_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([githubAppId])
  @@map("github_installations")
}

// Inbound GitHub webhook deliveries, kept so a push that did not deploy can be
// diagnosed without reading server logs. Deliveries are recorded on every path
// including rejection, because a mismatched webhook secret is the most common
// reason a push silently does nothing.
//
// Nothing from an unverified payload is stored. Rejected rows carry only the
// headers GitHub sends in the clear (event name, delivery id) and the outcome;
// repo, branch, and commit are populated only after the HMAC verifies.
model WebhookDelivery {
  id             String        @id @default(uuid())
  /// Null when the signature did not verify: an unverifiable delivery cannot be
  /// attributed to an organization, since the payload naming it is untrusted.
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// X-GitHub-Delivery, for cross-referencing GitHub's own delivery list.
  deliveryId     String?       @map("delivery_id")
  /// X-GitHub-Event ("push", "ping", "installation", ...). "" when absent.
  event          String
  /// Whether X-Hub-Signature-256 matched a connected App's secret.
  verified       Boolean
  /// rejected | ignored | accepted | error
  outcome        String
  /// Short, non-sensitive explanation of the outcome, shown in the UI.
  detail         String?       @db.Text
  repoFullName   String?       @map("repo_full_name")
  branch         String?
  commitSha      String?       @map("commit_sha")
  /// Deploys enqueued by this delivery.
  deployCount    Int           @default(0) @map("deploy_count")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

// --- Phase 4.5: Portable config bundles ------------------------------------

model BackupDestination {
  id              String           @id @default(uuid())
  organizationId  String           @map("organization_id")
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  kind            String // local | s3
  config          Json // local: { path }; s3: { bucket, region, endpoint?, prefix? }
  secretEncrypted Bytes?           @map("secret_encrypted") // s3: encrypted { accessKeyId, secretAccessKey }
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  bundles         Bundle[]
  schedules       BackupSchedule[]

  @@index([organizationId])
  @@map("backup_destinations")
}

model Bundle {
  id              String             @id @default(uuid())
  organizationId  String             @map("organization_id")
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  destinationId   String?            @map("destination_id")
  destination     BackupDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  scheduleId      String?            @map("schedule_id")
  schedule        BackupSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  filename        String
  sizeBytes       BigInt?            @map("size_bytes")
  appCount        Int                @map("app_count")
  includesSecrets Boolean            @map("includes_secrets")
  status          String             @default("ready") // ready | failed
  errorMessage    String?            @map("error_message") @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([scheduleId, createdAt])
  @@map("bundles")
}

model BackupSchedule {
  id                  String            @id @default(uuid())
  organizationId      String            @map("organization_id")
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  destinationId       String            @map("destination_id")
  destination         BackupDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  cron                String
  enabled             Boolean           @default(true)
  includeSecrets      Boolean           @default(true) @map("includes_secrets")
  // Passphrase to sign/encrypt scheduled bundles, encrypted at rest with the
  // instance key (SOHWE_ENCRYPTION_KEY). Required to restore scheduled bundles.
  passphraseEncrypted Bytes             @map("passphrase_encrypted")
  retentionCount      Int?              @map("retention_count")
  lastRunAt           DateTime?         @map("last_run_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  bundles             Bundle[]

  @@index([organizationId])
  @@map("backup_schedules")
}

// --- Phase 6: Multi-user ----------------------------------------------------

// A pending offer to join an organization at a given role. Sohwe does not send
// email: the API mints a random token, returns the join link exactly once, and
// stores only its SHA-256 hash. A lost link is unrecoverable by design — revoke
// the row and issue a new invitation.
model Invitation {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Lowercased. The accepting user must register with this address.
  email          String
  /// admin | member. Owners are never created by invitation.
  role           String
  /// SHA-256 of the raw token. The raw token exists only in the create response.
  tokenHash      String       @unique @map("token_hash")
  invitedById    String?      @map("invited_by_id")
  invitedBy      User?        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime     @map("expires_at")
  acceptedAt     DateTime?    @map("accepted_at")
  acceptedById   String?      @map("accepted_by_id")
  acceptedBy     User?        @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("invitations")
}

// Who did what, for org-scoped review. Rows are append-only and never carry
// secret material: env var changes record key names and counts, never values,
// and bundle events record passphrase presence, never the passphrase.
//
// actorId goes null if the user is removed, but actorEmail is denormalized so
// the trail stays readable after the account is gone.
model AuditLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?      @map("actor_id")
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalized actor identity, preserved after the user row is deleted.
  actorEmail     String       @map("actor_email")
  /// Dotted event name, e.g. "application.create", "env.update", "member.role_change".
  action         String
  /// application | deployment | volume | env | member | invitation | backup | github | organization
  targetType     String       @map("target_type")
  targetId       String?      @map("target_id")
  /// Human label at the time of the event (app slug, member email, ...).
  targetLabel    String?      @map("target_label")
  /// Non-secret detail: counts, key names, before/after roles.
  metadata       Json?
  ip             String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, targetType, targetId, createdAt])
  @@map("audit_logs")
}

// --- Phase 7: Managed datastores --------------------------------------------

// A Sohwe-owned Postgres or Redis container: official image, named volume,
// generated credentials, Sohwe labels. Not deployed from Git. Private by
// default — the container joins the internal networks of bound apps and is
// addressed by container DNS name. publicPort, when set, publishes the service
// port on the host (the Railway-style opt-in escape hatch for external access).
//
// credentialsEncrypted holds { username, password, database } for postgres and
// { password } for redis, encrypted with the instance key. The API generates
// credentials on every row-creation path (create and restore), so the worker
// only ever decrypts.
model Datastore {
  id                   String                    @id @default(uuid())
  organizationId       String                    @map("organization_id")
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind                 String // postgres | redis
  name                 String
  slug                 String
  engineVersion        String                    @map("engine_version") // postgres: 16 | 17; redis: 7
  status               String                    @default("provisioning") // provisioning | running | deleting | error | idle
  memoryLimitMb        Int?                      @map("memory_limit_mb")
  cpuLimit             Float?                    @map("cpu_limit")
  storageSizeHintBytes BigInt?                   @map("storage_size_hint_bytes")
  /// Host port the service is published on; null means private-only.
  publicPort           Int?                      @unique @map("public_port")
  credentialsEncrypted Bytes                     @map("credentials_encrypted")
  errorMessage         String?                   @map("error_message") @db.Text
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  bindings             DatastoreBinding[]
  projectBindings      ProjectDatastoreBinding[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("datastores")
}

// Which apps may use a datastore and which env var keys were injected into
// their encrypted env. envKeys records exactly what bind wrote, so unbind and
// password rotation know which keys to remove or rewrite.
model DatastoreBinding {
  id            String      @id @default(uuid())
  datastoreId   String      @map("datastore_id")
  datastore     Datastore   @relation(fields: [datastoreId], references: [id], onDelete: Cascade)
  applicationId String      @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  envKeys       String[]    @map("env_keys")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([datastoreId, applicationId])
  @@index([applicationId])
  @@map("datastore_bindings")
}

// A project binding is resolved at deploy time rather than copying a password
// into every service row. Empty serviceIds means every service; otherwise the
// same connection URL is injected only into the selected services.
model ProjectDatastoreBinding {
  id          String    @id @default(uuid())
  datastoreId String    @map("datastore_id")
  datastore   Datastore @relation(fields: [datastoreId], references: [id], onDelete: Cascade)
  projectId   String    @map("project_id")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  envKey      String    @map("env_key")
  serviceIds  String[]  @map("service_ids")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([datastoreId, projectId])
  @@index([projectId])
  @@map("project_datastore_bindings")
}

// --- Phase 8: Custom domain DNS assist ---------------------------------------

// An org-level DNS provider API credential (currently only "cloudflare"), used
// to create or update the record a custom domain needs. The token is encrypted
// with the instance key (SOHWE_ENCRYPTION_KEY) and is never returned by any
// endpoint — the list route reports only that a credential exists.
model DnsProviderCredential {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String // cloudflare
  tokenEncrypted Bytes        @map("token_encrypted")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, provider])
  @@map("dns_provider_credentials")
}
