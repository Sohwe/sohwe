{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
      "dev": { "cache": false, "persistent": true },
      "build": {
        "dependsOn": ["^build"],
        "outputs": ["dist/**"],
        "passThroughEnv": ["DATABASE_URL"]
      },
      "lint": {},
      "typecheck": { "dependsOn": ["^build"], "passThroughEnv": ["DATABASE_URL"] },
      "test": {
        "dependsOn": ["^build"],
        "passThroughEnv": [
          "DATABASE_URL",
          "REDIS_URL",
          "SESSION_SECRET",
          "SOHWE_ENCRYPTION_KEY",
          "TEST_DATABASE_URL"
        ]
      }
    }
  }