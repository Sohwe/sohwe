#!/usr/bin/env bash
# shellcheck shell=bash
#
# Sohwe — host-side management CLI installed by scripts/install.sh.
#
# All state is in /etc/sohwe. Every subcommand loads /etc/sohwe/sohwe.env and
# dispatches to `docker compose` with the right overlay files.

set -euo pipefail

readonly DATA_DIR="/etc/sohwe"
readonly ENV_FILE="${DATA_DIR}/sohwe.env"
readonly COMPOSE_BASE="${DATA_DIR}/docker-compose.prod.yml"
readonly PREV_VERSION_FILE="${DATA_DIR}/.previous-version"
readonly REPO="Sohwe/sohwe"
# Image namespace — GHCR lowercases the owner segment.
readonly IMAGE_NS="sohwe/sohwe"
readonly RAW_BASE="https://raw.githubusercontent.com/${REPO}/main"

# Plain sudo, not -E: the wrapper reads everything from /etc/sohwe/sohwe.env,
# and Ubuntu 25.10+'s sudo-rs warns that -E is unsupported.
[[ $EUID -eq 0 ]] || { exec sudo bash "$0" "$@"; }

[[ -f "${ENV_FILE}" ]] || { echo "Missing ${ENV_FILE}. Run the installer first." >&2; exit 1; }
[[ -f "${COMPOSE_BASE}" ]] || { echo "Missing ${COMPOSE_BASE}." >&2; exit 1; }

# Read overlays from env without sourcing untrusted content into this shell.
overlays_from_env() {
    grep -E '^SOHWE_COMPOSE_OVERLAYS=' "${ENV_FILE}" | head -n1 | cut -d= -f2- | tr -d '"'
}

# Build the compose invocation. The compose plugin reads --env-file once
# and substitutes variables referenced in the YAML.
compose() {
    local overlays; overlays="$(overlays_from_env)"
    local args=(--env-file "${ENV_FILE}" -f "${COMPOSE_BASE}")
    if [[ -n "${overlays}" ]]; then
        # Overlays are colon-separated paths, mirroring COMPOSE_FILE convention.
        IFS=':' read -r -a extra <<< "${overlays}"
        for f in "${extra[@]}"; do args+=(-f "${f}"); done
    fi
    docker compose "${args[@]}" "$@"
}

current_version() {
    grep -E '^SOHWE_VERSION=' "${ENV_FILE}" | head -n1 | cut -d= -f2-
}

set_version_in_env() {
    local new="$1"
    # Update SOHWE_VERSION and every SOHWE_IMAGE_* line to match.
    sed -i \
        -e "s|^SOHWE_VERSION=.*|SOHWE_VERSION=${new}|" \
        -e "s|^SOHWE_IMAGE_API=.*|SOHWE_IMAGE_API=ghcr.io/${IMAGE_NS}-api:${new}|" \
        -e "s|^SOHWE_IMAGE_WORKER=.*|SOHWE_IMAGE_WORKER=ghcr.io/${IMAGE_NS}-worker:${new}|" \
        -e "s|^SOHWE_IMAGE_DASHBOARD=.*|SOHWE_IMAGE_DASHBOARD=ghcr.io/${IMAGE_NS}-dashboard:${new}|" \
        "${ENV_FILE}"
}

usage() {
    cat <<'EOF'
Sohwe CLI

Usage:
  sohwe <command> [args]

Commands:
  up                  Start the stack and apply any config changes in sohwe.env.
  down                Stop the stack (containers remain; volumes preserved).
  restart             Apply pending sohwe.env / compose changes and restart.
  status              Show service state.
  logs [service]      Follow logs for the stack or a single service.
  pull                Pull the images pinned in sohwe.env.
  migrate             Apply pending DB migrations (`prisma migrate deploy`)
                      inside the api container. A database created by v0.3.8 or
                      earlier is baselined automatically on first run.
  migrate-status      Show which migrations are applied and which are pending.
  update [version]    Upgrade to `version` (default: latest). Pulls, applies
                      migrations, restarts. Previous version stashed for
                      rollback.
  rollback            Roll back to the version saved by the last `update`.
                      Does NOT revert schema changes.
  version             Show the currently installed version.
  env                 Print the path to the env file.
  help                This message.

Secrets live in /etc/sohwe/sohwe.env. Edit with care.
EOF
}

# `up` and `restart` both end with a Traefik bounce. Traefik's Docker provider
# sometimes misses a label change when the dashboard container is recreated
# (observed: stale Host(...) router from a removed HTTPS overlay still winning,
# returning 404 for every request). Bouncing Traefik after config-affecting
# operations is cheap and guarantees a clean router table. Same safeguard is
# already in cmd_update and cmd_rollback.
#
# `restart` is deliberately implemented as `up -d` rather than `compose restart`.
# Operators expect "restart" to apply any edits they made to sohwe.env or the
# compose files (overlays, new version pins, etc). Plain `compose restart` only
# bounces existing containers with their existing config, which silently
# ignores those edits.
cmd_up() {
    compose up -d "$@"
    compose restart traefik >/dev/null 2>&1 || true
}
cmd_down()    { compose down "$@"; }
cmd_restart() {
    compose up -d "$@"
    compose restart traefik >/dev/null 2>&1 || true
}
cmd_status()  { compose ps "$@"; }
cmd_logs()    { compose logs -f "$@"; }
cmd_pull()    { compose pull "$@"; }
cmd_version() { current_version; }
cmd_env()     { echo "${ENV_FILE}"; }

# The `init` migration reproduces the schema that every published tag up to and
# including v0.3.8 shipped. Those releases created their schema with
# `prisma db push`, so they have no `_prisma_migrations` table and must be
# baselined once before versioned migrations can take over. Do not renumber.
readonly BASELINE_MIGRATION="20260722000000_init"

# The api image has Prisma, the schema, and the migrations baked in at
# /app/packages/db.
prisma_in_api() {
    compose exec -T -w /app/packages/db api pnpm exec prisma "$@"
}

cmd_migrate() {
    # Versioned migrations, applied with `prisma migrate deploy`. Unlike the old
    # `db push --accept-data-loss` this never drops a column on its own: it
    # replays the reviewed SQL in packages/db/prisma/migrations.
    #
    # Three possible database states:
    #
    #   1. Fresh install     -- empty database; deploy applies every migration.
    #   2. Already migrated  -- `_prisma_migrations` exists; deploy applies only
    #                           what is new.
    #   3. Pre-migration install (<= v0.3.8, schema created by `db push`) --
    #                           deploy refuses with P3005 "schema is not empty".
    #
    # Case 3 is unambiguous: every tag up to v0.3.8 shipped a byte-identical
    # schema, so such a database is exactly the `init` migration. We mark init
    # as already-applied and re-run deploy, which then applies only the later
    # migrations. Baselining records a row in `_prisma_migrations`; it runs no
    # DDL and cannot lose data.
    local out
    if out="$(prisma_in_api migrate deploy 2>&1)"; then
        echo "${out}"
        return 0
    fi

    if ! grep -q 'P3005' <<< "${out}"; then
        echo "${out}" >&2
        return 1
    fi

    echo "Existing pre-migration database detected."
    echo "Baselining at ${BASELINE_MIGRATION} (records history only, no schema change)…"
    prisma_in_api migrate resolve --applied "${BASELINE_MIGRATION}"
    prisma_in_api migrate deploy
}

cmd_migrate_status() {
    prisma_in_api migrate status
}

refresh_compose_files() {
    # Keep compose files on the host in sync with the tagged version. Simpler
    # than shipping a new installer for every release.
    local tmp
    tmp="$(mktemp)"
    if curl -fsSL "${RAW_BASE}/docker-compose.prod.yml" -o "${tmp}"; then
        install -m 644 "${tmp}" "${COMPOSE_BASE}"
    fi
    if curl -fsSL "${RAW_BASE}/docker-compose.https.yml" -o "${tmp}"; then
        install -m 644 "${tmp}" "${DATA_DIR}/docker-compose.https.yml"
    fi
    rm -f "${tmp}"
}

cmd_update() {
    local target="${1:-latest}"
    local prev; prev="$(current_version)"
    [[ -n "${prev}" ]] || { echo "Could not read current version from ${ENV_FILE}" >&2; exit 1; }

    echo "Updating Sohwe: ${prev} -> ${target}"
    refresh_compose_files
    echo "${prev}" > "${PREV_VERSION_FILE}"
    set_version_in_env "${target}"

    compose pull
    compose up -d
    cmd_migrate
    # Occasionally Traefik's Docker provider misses a label update when the
    # dashboard container is recreated. Bouncing Traefik after everything else
    # has settled is cheap and guarantees the router table is fresh.
    compose restart traefik >/dev/null 2>&1 || true
    echo "Sohwe ${target} is live. Previous version (${prev}) saved for rollback."
}

cmd_rollback() {
    [[ -f "${PREV_VERSION_FILE}" ]] \
        || { echo "No previous version recorded. Nothing to roll back to." >&2; exit 1; }
    local prev; prev="$(cat "${PREV_VERSION_FILE}")"
    local current; current="$(current_version)"
    echo "Rolling back Sohwe: ${current} -> ${prev}"
    set_version_in_env "${prev}"
    compose pull
    compose up -d
    compose restart traefik >/dev/null 2>&1 || true
    # Intentionally NOT running `migrate` on rollback. Prisma migrations are
    # forward-only: there are no down-migrations to replay, and re-applying the
    # OLD schema over the new data would drop whatever the upgrade added. In
    # practice additive migrations (new tables/columns) leave the previous
    # version working fine, because older code simply ignores them. If a release
    # ever lands a destructive migration, its CHANGELOG entry must say so and the
    # operator should restore a DB backup instead of rolling back.
    echo "Rolled back to ${prev}. Note: DB schema is NOT reverted."
    rm -f "${PREV_VERSION_FILE}"
}

main() {
    local cmd="${1:-help}"; shift || true
    case "${cmd}" in
        up)       cmd_up       "$@" ;;
        down)     cmd_down     "$@" ;;
        restart)  cmd_restart  "$@" ;;
        status|ps) cmd_status  "$@" ;;
        logs)     cmd_logs     "$@" ;;
        pull)     cmd_pull     "$@" ;;
        migrate)  cmd_migrate  "$@" ;;
        migrate-status) cmd_migrate_status "$@" ;;
        update)   cmd_update   "$@" ;;
        rollback) cmd_rollback "$@" ;;
        version|--version|-v) cmd_version ;;
        env)      cmd_env ;;
        help|--help|-h|"") usage ;;
        *) echo "Unknown command: ${cmd}" >&2; usage >&2; exit 2 ;;
    esac
}

main "$@"
