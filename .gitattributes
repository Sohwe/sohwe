# Normalize line endings. Without this, a commit from a Windows checkout can
# introduce CRLF, and a CRLF shebang is a fatal "bad interpreter" error when the
# installer or host CLI runs on a Linux host.

# Default: let Git decide text vs binary, and store text as LF in the repo.
* text=auto eol=lf

# Shell scripts run on Linux and MUST stay LF regardless of platform.
*.sh text eol=lf
scripts/sohwe text eol=lf

# Binary assets Git must never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
