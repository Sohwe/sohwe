DATABASE_URL="postgresql://sohwe:password@localhost:5432/sohwe_dev"
REDIS_URL="redis://localhost:6379"
PORT=3001

# Use a long random value in shared or deployed environments.
SESSION_SECRET="change-me-to-a-long-random-string"

# 32 random bytes, base64 encoded. Example generator:
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
SOHWE_ENCRYPTION_KEY="change-me-to-a-32-byte-base64-string"

# Local dev is HTTP-only. Production installer writes this based on whether HTTPS is configured.
SOHWE_HTTPS_ENABLED=false

# Used by the API config endpoint and worker app URLs.
SOHWE_BASE_DOMAIN="sohwe.localhost"

# Optional first-run installer gate. Production installer sets this.
# SOHWE_SETUP_PASSWORD="change-me"

# Optional Traefik/HTTPS settings for app domains.
# SOHWE_CERT_RESOLVER="letsencrypt"
# TRAEFIK_DOCKER_NETWORK="sohwe_proxy"
