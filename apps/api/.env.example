DATABASE_URL="postgresql://sohwe:password@localhost:5432/sohwe_dev"
REDIS_URL="redis://localhost:6379"
PORT=3001

# Use a long random value in shared or deployed environments.
SESSION_SECRET="change-me-to-a-long-random-string"

# 32 random bytes, base64 encoded. Example generator:
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
SOHWE_ENCRYPTION_KEY="change-me-to-a-32-byte-base64-string"

# Local dev is HTTP-only. Production installer writes this based on whether HTTPS is configured.
SOHWE_HTTPS_ENABLED=false

# Used by the API config endpoint and worker app URLs.
SOHWE_BASE_DOMAIN="sohwe.localhost"

# Externally reachable base URL of this instance, no trailing slash. Baked into
# the GitHub App manifest (webhook + redirect URLs) when you connect GitHub, and
# used by the worker to link commit statuses to the deployment page. GitHub must
# be able to reach it, so local development needs a tunnel (cloudflared, ngrok,
# tailscale funnel) pointed at the dashboard. Unset falls back to the request
# origin, which is only a guess.
# SOHWE_PUBLIC_URL="https://sohwe.example.com"

# Optional first-run installer gate. Production installer sets this.
# SOHWE_SETUP_PASSWORD="change-me"

# Optional CORS allow-origin for the API. Leave unset in production: the
# dashboard is served same-origin through nginx, so no cross-origin access is
# needed (defaults to disabled when NODE_ENV=production, and to
# http://localhost:3000 otherwise). Set a comma-separated list of origins, or
# "*", only if you front the API from a different origin.
# SOHWE_CORS_ORIGIN="https://dashboard.example.com"

# Optional Traefik/HTTPS settings for app domains.
# SOHWE_CERT_RESOLVER="letsencrypt"
# TRAEFIK_DOCKER_NETWORK="sohwe_proxy"

# Optional host file browser (dashboard "Host files" page, admin-and-above).
# Comma-separated absolute paths the API may list/read, e.g. "/etc/sohwe".
# Unset disables the feature entirely. Every list and file read is recorded in
# the audit log. In production the API container only sees what compose mounts
# in (/etc/sohwe by default, read-only).
# SOHWE_HOST_FS_ALLOWLIST="/etc/sohwe"
