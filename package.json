{
  "name": "sohwe",
  "version": "0.3.8",
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:push": "pnpm --filter @sohwe/db exec prisma db push",
    "db:migrate": "pnpm --filter @sohwe/db exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @sohwe/db exec prisma migrate deploy",
    "db:migrate:status": "pnpm --filter @sohwe/db exec prisma migrate status",
    "db:studio": "pnpm --filter @sohwe/db exec prisma studio",
    "db:generate": "pnpm --filter @sohwe/db exec prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.58.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=24"
  }
}